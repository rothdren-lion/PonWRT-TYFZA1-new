# GWRT theme + PON WAN settings merged in from the AN7581 series source tree.
#
# Source: gwrt-theme-V3/manifest/config.fragment.an7581 (theme part only) and
# gwrt-mk-an7581-config.sh (PON WAN app).  Airoha-only kernel drivers and the
# OAF/appfilter stack are intentionally NOT listed: TYFZA1 is Realtek
# RTL9617CVW, and the AN7581 generator also strips those packages to stay
# inside its ~50 MB volume budget.
#
# This fragment is NOT merged automatically.  Apply it on purpose:
#   sh port/scripts/sync-gwrt-theme.sh <openwrt-tree>
# or append it to .config yourself.

# Theme.  The package ships its own runtime repair hook (init.d/gwrt-theme),
# own helper scripts and helpers for the dashboard; the only hard dependency
# is luci-base.
CONFIG_PACKAGE_luci-theme-gwrt=y

# Theme dashboard helpers used by the OTA card and the client list.
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y

# PON WAN service settings (VLAN / LAN ID) — port-neutral UCI + netifd app.
CONFIG_PACKAGE_luci-app-pon-wan=y

# Chinese UI, as in the AN7581 fragment.
CONFIG_LUCI_LANG_zh_Hans=y