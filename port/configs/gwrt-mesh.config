# GWRT mesh + agent packages.
#
# This fragment is NOT merged automatically.  Apply it on purpose:
#   sh port/scripts/sync-gwrt-mesh.sh <openwrt-tree>
# or append it to .config yourself.  port/scripts/build.sh does it when
# TYFZA1_GWRT_MESH=1 (the default), which is how CI builds it.

# Telemetry / command agent (aarch64 get the prebuilt gwrt-agent.bin).
CONFIG_PACKAGE_gwrt-agent=y

# Mesh status LED plus WPS/BTN pairing front-end.
CONFIG_PACKAGE_gwrt-mesh-led=y

# Router <-> real-AP state machine (needs relayd + netfilter queue).
CONFIG_PACKAGE_gwrt-mesh-apmode=y

# wifiroam v5 pages/daemon overlay and the wifiroam-dpi helper.
# Staged but OFF by default: the overlay is inert without the upstream wifiroam
# base package (init script, /usr/share/wifiroam, /etc/config/wifiroam), which
# is not in any OpenWrt feed.  Enable it together with that base package.
# CONFIG_PACKAGE_gwrt-wifiroam-v5=y

# Enabling-only defaults for this board (services stay off until enabled).
CONFIG_PACKAGE_gwrt-mesh-defaults=y

# Dependencies the mesh packages pull in.  Listed explicitly so a dropped
# symbol fails the build instead of silently shrinking the mesh feature set.
CONFIG_PACKAGE_relayd=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_libnetfilter-queue=y
CONFIG_PACKAGE_libmnl=y
CONFIG_PACKAGE_libnfnetlink=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_libgcc=y